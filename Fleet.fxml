<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500" prefWidth="900" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="com.example.airlinesystem.FleetController">

    <TableView fx:id="tblFleet" layoutX="20" layoutY="20" prefHeight="250" prefWidth="850">
        <columns>
            <TableColumn fx:id="colId" prefWidth="60" text="Fleet ID" />
            <TableColumn fx:id="colAircraft" prefWidth="120" text="Aircraft" />
            <TableColumn fx:id="colClub" prefWidth="100" text="Club Capacity" />
            <TableColumn fx:id="colEco" prefWidth="100" text="Eco Capacity" />
            <TableColumn fx:id="colEngine" prefWidth="100" text="Engine" />
            <TableColumn fx:id="colSpeed" prefWidth="100" text="Cruise Speed" />
            <TableColumn fx:id="colLength" prefWidth="100" text="Length" />
            <TableColumn fx:id="colWing" prefWidth="100" text="Wing Span" />
        </columns>
    </TableView>

    <Label layoutX="20" layoutY="290" text="Aircraft" />
    <TextField fx:id="txtAircraft" layoutX="120" layoutY="285" />

    <Label layoutX="20" layoutY="330" text="Club Capacity" />
    <TextField fx:id="txtClub" layoutX="120" layoutY="325" />

    <Label layoutX="303.0" layoutY="290.0" text="Eco Capacity" />
    <TextField fx:id="txtEco" layoutX="403.0" layoutY="285.0" />

    <Label layoutX="20" layoutY="370" text="Engine" />
    <TextField fx:id="txtEngine" layoutX="120" layoutY="365" />

    <Label layoutX="303.0" layoutY="330.0" text="Cruise Speed" />
    <TextField fx:id="txtSpeed" layoutX="403.0" layoutY="325.0" />

    <Label layoutX="20" layoutY="410" text="Length" />
    <TextField fx:id="txtLength" layoutX="120" layoutY="405" />

    <Label layoutX="303.0" layoutY="370.0" text="Wing Span" />
    <TextField fx:id="txtWing" layoutX="403.0" layoutY="365.0" />

    <Button layoutX="149.0" layoutY="454.0" onAction="#onAdd" text="Add" />
    <Button layoutX="303.0" layoutY="454.0" onAction="#onUpdate" text="Update" />
    <Button layoutX="218.0" layoutY="454.0" onAction="#onDelete" text="Delete" />
</AnchorPane>
