<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="500" prefWidth="900" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="com.example.airlinesystem.CancellationController">

    <VBox spacing="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">

        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ticket Cancellation" />

        <!-- Search and Show All -->
        <HBox spacing="10">
            <TextField fx:id="txtSearchPNR" promptText="Search PNR" />
            <Button fx:id="btnSearch" prefWidth="80" text="Search" />
            <Button fx:id="btnShowAll" prefWidth="100" text="Show All" />
        </HBox>

        <!-- Tickets Table -->
        <TableView fx:id="tblTickets" prefHeight="380">
            <columns>
                <TableColumn fx:id="colPNR" prefWidth="100" text="PNR" />
                <TableColumn fx:id="colClass" prefWidth="100" text="Class" />
                <TableColumn fx:id="colTravelDate" prefWidth="150" text="Travel Date" />
                <TableColumn fx:id="colDaysLeft" prefWidth="80" text="Days Left" />
                <TableColumn fx:id="colHoursLeft" prefWidth="80" text="Hours Left" />
                <TableColumn fx:id="colBasicFare" prefWidth="120" text="Basic Fare" />
                <TableColumn fx:id="colCancelAmount" prefWidth="120" text="Cancel Amount" />
            </columns>
         <VBox.margin>
            <Insets right="30.0" />
         </VBox.margin>
        </TableView>

        <!-- Cancel Button -->
        <Button fx:id="btnCancelTicket" prefWidth="200" text="Cancel Selected Ticket">
         <VBox.margin>
            <Insets bottom="10.0" left="250.0" right="200.0" />
         </VBox.margin></Button>
    </VBox>

</AnchorPane>
